      ],
      [
        "FORMOSA 07 - Fields and Waterfalls",
        "Warm acoustic soul and laidback citypop,98 BPM,D major. Fingerstyle acousticguitar melody, mellow Rhodes chords, warm bass, brush snare, shakers and subtle handpercussion. Sunny ricefields, mountain foothills and waterfall scenery, joyful relaxed travel, memorable lyrical hooks."
      ],
      [
        "FORMOSA 08 - North Coast Nights",
        "Smooth instrumental R&B/funk,106 BPM,A minor with jazzy Dorian colors. Clean syncopated guitar, rounded melodic bass, tight snare, airy Rhodes, small saxophone hook, warm neon and northern coastal evening drive. Engaging groove comfortable for a longjourney."
      ],
      [
        "FORMOSA 09 - Tea Hills Sunset",
        "Mellow touring soul and acoustic R&B,92 BPM,F major. Warm acoustic guitar, expressive Rhodes electricpiano, gentle bass countermelody, brushed drums and shaker. Tea hills afternoon and glowing cape sunset, unhurried yet moving, clear sweet melody with varied answeringphrases."
      ],
      [
        "FORMOSA 10 - Island Homecoming",
