      [
        "FORMOSA 02 - Palm Coast",
        "Coastal road-trip city pop and comfortable R&B, 104 BPM, A major. Clean chorus guitar, Rhodes electric piano, gently syncopated bass, tight brushed snare and shakers, memorable relaxed melody, sunshine and palm trees along southern Taiwan."
      ],
      [
        "FORMOSA 03 - Old Town Neon",
        "Instrumental soul and rhythmic R&B, 100 BPM, E minor with warm major-seven chords. Muted funk guitar, round electric bass, smooth Rhodes piano, crisp organic drums, playful saxophone answering phrases, Taiwan old towns and night-market neon, warm and relaxed but forward moving."
      ],
      [
        "FORMOSA 04 - Mountain Switchbacks",
        "Melodic uplifting light rock, 112 BPM, G major. Nimble clean electric guitar hooks, warm acoustic rhythm guitar, driving bass and steady live drums, forest railway and winding mountain roads of Taiwan, adventurous controlled momentum, friendly sunny ensemble."
      ],
      [
        "FORMOSA 05 - Lake and Clouds",
        "Comfortable instrumental R&B / soft soul, 96 BPM, C major. Warm Rhodes chords, lyrical clean guitar, rounded bass, brushed snare and crisp hi-hats, spacious lake morning and cloudlit mountain touring, calm optimism with a persistent rolling groove."
      ]
    ],
    "groups6to10": [
      [
        "FORMOSA 06 - Marble and Ocean",
